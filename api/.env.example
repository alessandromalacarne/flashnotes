# Works with both compose.yaml at the repo root and scripts/pg.sh (local nix)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flashnotes"
PORT=3000

# Interface the API binds to. Defaults to 127.0.0.1.
# HOST=0.0.0.0

# Optional: store sessions in Redis instead of memory. The compose.yaml Redis
# requires the password below and only listens on 127.0.0.1.
# REDIS_URL="redis://:redis@127.0.0.1:6379"
