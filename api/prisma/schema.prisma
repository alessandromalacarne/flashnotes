generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id         String   @id @default(uuid(7))
  userId     String
  content    String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  groups     Group[]
}

model Group {
  id     String @id @default(uuid(7))
  userId String
  name   String

  user   User   @relation(fields: [userId], references: [id])
  notes  Note[]

  @@unique([userId, name])
}

model User {
  id           String  @id @default(uuid(7))
  email        String  @unique
  passwordHash String

  notes        Note[]
  groups       Group[]
}
